# Archivo del proyecto Electrocasa
# COMMAND ----------
# Definir variables de entorno
catalog_name = "catalogo_electrocasa"
volume_path = f"/Volumes/{catalog_name}/default/datos_proyecto"

# Crear Schemas (Capas Medallion)
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {catalog_name}.bronze;")
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {catalog_name}.silver;")
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {catalog_name}.gold;")

# Crear subdirectorios en el volumen para checkpoints y landing de datos
dbutils.fs.mkdirs(f"{volume_path}/landing/ventas")
dbutils.fs.mkdirs(f"{volume_path}/landing/productos")
dbutils.fs.mkdirs(f"{volume_path}/landing/empleados")
dbutils.fs.mkdirs(f"{volume_path}/landing/resenas")
dbutils.fs.mkdirs(f"{volume_path}/landing/devoluciones")
dbutils.fs.mkdirs(f"{volume_path}/checkpoints")

# Definir Permisos de Gobierno (Gobernanza)
spark.sql(f"CREATE GROUP IF NOT EXISTS grupo_ingenieria;")
spark.sql(f"CREATE GROUP IF NOT EXISTS grupo_analistas;")
spark.sql(f"CREATE GROUP IF NOT EXISTS grupo_auditoria;")

# Asignación de permisos
spark.sql(f"GRANT ALL PRIVILEGES ON SCHEMA {catalog_name}.bronze TO grupo_ingenieria;")
spark.sql(f"GRANT ALL PRIVILEGES ON SCHEMA {catalog_name}.silver TO grupo_ingenieria;")
spark.sql(f"GRANT ALL PRIVILEGES ON SCHEMA {catalog_name}.gold TO grupo_ingenieria;")

spark.sql(f"GRANT SELECT ON SCHEMA {catalog_name}.gold TO grupo_analistas;")
spark.sql(f"GRANT SELECT ON SCHEMA {catalog_name}.gold TO grupo_auditoria;")